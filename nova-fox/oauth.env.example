# Nova Fox wiki — instance environment (the live file is
# ~/nova-fox-wiki/oauth.env on awsbox, mode 0600, never in git).
PHEXT_PUBLIC_URL=https://fox.phext.io
PHEXT_SESSION_SECRET=<64 hex chars, generated on the box>
PHEXT_COOKIE_SECURE=1
# Sign-in: the wiki takes its own GitHub OAuth app (one callback
# per app; the production editor's app points at edit.phext.io).
# Callback: https://fox.phext.io/api/auth/github/callback
# Fill these two lines, then:
#   systemctl --user restart nova-fox-wiki
#   bash ~/nova-fox-wiki-launch/install.sh   (opens the write side)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
